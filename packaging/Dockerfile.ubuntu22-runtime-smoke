# Validate the already-built archive, with no source tree or Python installation.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libegl1 libgl1 libopengl0 libnss3 libnspr4 libasound2 libatomic1 \
    libglib2.0-0 libfontconfig1 libfreetype6 libxi6 libxkbfile1 libxss1 libxtst6 libcups2 libpulse0 \
    libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 \
    libxcb-image0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
    libxrandr2 libxdamage1 libxcomposite1 libxfixes3 libx11-xcb1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /artifacts
COPY AndroidAutomationStudio-ubuntu-x86_64.tar.gz AndroidAutomationStudio-ubuntu-x86_64.tar.gz.sha256 ./
RUN sha256sum -c AndroidAutomationStudio-ubuntu-x86_64.tar.gz.sha256 && \
    ! command -v python && ! command -v python3 && \
    mkdir -p '/opt/Portable Installation With Spaces' /evidence && \
    tar xzf AndroidAutomationStudio-ubuntu-x86_64.tar.gz -C '/opt/Portable Installation With Spaces' && \
    chmod 1777 /evidence && \
    (cat /etc/os-release; getconf GNU_LIBC_VERSION; printf '%s\n' 'No system python/python3 executable installed') > /evidence/ubuntu22-runtime-info.txt
USER 65534:65534
# Sandbox override belongs solely to this isolated container smoke invocation;
# the actual portable launcher and production startup retain normal defaults.
RUN QT_QPA_PLATFORM=offscreen QTWEBENGINE_DISABLE_SANDBOX=1 QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu \
    '/opt/Portable Installation With Spaces/AndroidAutomationStudio/run-studio.sh' \
    --release-smoke-report /evidence/ubuntu22-clean-runtime-smoke.json
