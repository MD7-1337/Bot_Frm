# syntax=docker/dockerfile:1
FROM ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 python3-pip binutils libegl1 libgl1 libopengl0 \
    libglib2.0-0 libfontconfig1 libfreetype6 libxi6 libxkbfile1 libxss1 libxtst6 libcups2 libpulse0 \
    libnss3 libnspr4 libasound2 libxkbcommon-x11-0 libxcb-cursor0 \
    libxcb-icccm4 libxcb-keysyms1 libxcb-image0 libxcb-render-util0 \
    libxcb-shape0 libxcb-xinerama0 libxrandr2 libxdamage1 libxcomposite1 \
    libx11-xcb1 libdbus-1-3 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=proxy_ca,required=true \
    PIP_CERT=/run/secrets/proxy_ca python3 -m pip install --no-cache-dir uv==0.12.23
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN --mount=type=secret,id=proxy_ca,required=true \
    SSL_CERT_FILE=/run/secrets/proxy_ca uv sync --locked --python 3.12 --no-install-project
RUN --mount=type=bind,source=.,target=/build-context,readonly \
    cp -a /build-context/app /build-context/editor_web /build-context/packaging \
          /build-context/tools /build-context/docs /src/
RUN --mount=type=secret,id=proxy_ca,required=true \
    apt-get update && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/* && \
    SSL_CERT_FILE=/run/secrets/proxy_ca uv sync --locked --python 3.12 && \
    SSL_CERT_FILE=/run/secrets/proxy_ca uv pip install --python .venv/bin/python PyInstaller==6.12.0
ARG STUDIO_BUILD_COMMIT=uncommitted-workspace
ENV STUDIO_BUILD_COMMIT=${STUDIO_BUILD_COMMIT}
# These flags belong only to this isolated headless/root build-test invocation.
# The distributed launcher never exports a sandbox override.
RUN QT_QPA_PLATFORM=offscreen QTWEBENGINE_DISABLE_SANDBOX=1 \
    QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu .venv/bin/python tools/build_linux.py

FROM ubuntu:22.04 AS smoke
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libegl1 libgl1 libopengl0 libnss3 libnspr4 libasound2 libatomic1 \
    libglib2.0-0 libfontconfig1 libfreetype6 libxi6 libxkbfile1 libxss1 libxtst6 libcups2 libpulse0 \
    libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 \
    libxcb-image0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
    libxrandr2 libxdamage1 libxcomposite1 libx11-xcb1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/dist /artifacts
RUN ! command -v python && ! command -v python3 && \
    (cat /etc/os-release; getconf GNU_LIBC_VERSION; printf '%s\n' 'No system python/python3 executable installed') > /artifacts/ubuntu22-runtime-info.txt && \
    mkdir -p '/tmp/Portable Installation With Spaces' && \
    tar xzf /artifacts/AndroidAutomationStudio-ubuntu-x86_64.tar.gz -C '/tmp/Portable Installation With Spaces' && \
    QT_QPA_PLATFORM=offscreen QTWEBENGINE_DISABLE_SANDBOX=1 QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu \
    '/tmp/Portable Installation With Spaces/AndroidAutomationStudio/run-studio.sh' \
      --release-smoke-report /artifacts/ubuntu22-clean-runtime-smoke.json
